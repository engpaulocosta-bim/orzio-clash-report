<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OrzioClashReport.Launcher.Desktop.ViewModels"
             xmlns:views="using:OrzioClashReport.Launcher.Desktop.Views"
             xmlns:l="using:OrzioClashReport.Launcher.Desktop.Localization"
             x:Class="OrzioClashReport.Launcher.Desktop.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://OrzioClashReport.Launcher.Desktop/Theme/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://OrzioClashReport.Launcher.Desktop/Theme/Styles.axaml" />
  </Application.Styles>

  <Application.DataTemplates>

    <!-- Pages -->
    <DataTemplate DataType="vm:HomeViewModel">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:QuickReportViewModel">
      <views:QuickReportView />
    </DataTemplate>
    <DataTemplate DataType="vm:OperationSectionViewModel">
      <views:OperationSectionView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:SectionPlaceholderViewModel">
      <views:SectionPlaceholderView />
    </DataTemplate>

    <!-- Shared parts -->
    <DataTemplate DataType="vm:OperationRunnerViewModel">
      <views:OperationRunnerView />
    </DataTemplate>
    <DataTemplate DataType="vm:OperationFormViewModel">
      <views:OperationFormView />
    </DataTemplate>

    <!-- Typed form fields -->
    <DataTemplate DataType="vm:FileFieldViewModel">
      <StackPanel Spacing="{DynamicResource OrzioSpaceXs}" Margin="{DynamicResource OrzioStackGapMd}">
        <TextBlock Classes="caption" Text="{Binding Label}" />
        <TextBlock Classes="tertiary" Text="{Binding Hint}" />
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource OrzioSpaceSm}">
          <Button Content="{Binding ButtonText}" Command="{Binding PickCommand}" />
          <TextBlock VerticalAlignment="Center" Text="{Binding FileName}" IsVisible="{Binding HasValue}" />
          <TextBlock Classes="tertiary"
                     VerticalAlignment="Center"
                     Text="{l:Loc Field.NotChosen}"
                     IsVisible="{Binding !HasValue}" />
          <Button Classes="link"
                  Content="{l:Loc Action.Clear}"
                  Command="{Binding ClearCommand}"
                  IsVisible="{Binding HasValue}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:TextFieldViewModel">
      <StackPanel Spacing="{DynamicResource OrzioSpaceXs}"
                  Margin="{DynamicResource OrzioStackGapMd}"
                  IsVisible="{Binding IsShown}">
        <TextBlock Classes="caption" Text="{Binding Label}" />
        <TextBlock Classes="tertiary" Text="{Binding Hint}" />
        <TextBox Text="{Binding Value}"
                 HorizontalAlignment="Left"
                 MinWidth="{DynamicResource OrzioDialogMaxWidth}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:OccurrenceIndexFieldViewModel">
      <StackPanel Spacing="{DynamicResource OrzioSpaceXs}" Margin="{DynamicResource OrzioStackGapMd}">
        <TextBlock Classes="caption" Text="{Binding Label}" />
        <TextBlock Classes="tertiary" Text="{Binding Hint}" />
        <TextBox Text="{Binding Value}" HorizontalAlignment="Left" MinWidth="{DynamicResource OrzioSidebarWidth}" />
        <StackPanel Orientation="Horizontal"
                    Spacing="{DynamicResource OrzioSpaceXs}"
                    IsVisible="{Binding HasFormatError}">
          <TextBlock Text="!" />
          <TextBlock Classes="secondary" Text="{Binding FormatError}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:DecisionKindFieldViewModel">
      <StackPanel Spacing="{DynamicResource OrzioSpaceSm}" Margin="{DynamicResource OrzioStackGapMd}">
        <TextBlock Classes="caption" Text="{Binding Label}" />
        <ListBox Classes="nav"
                 ItemsSource="{Binding Options}"
                 SelectedItem="{Binding Selected}"
                 Background="Transparent"
                 BorderThickness="{DynamicResource OrzioBorderNone}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:DecisionKindOptionViewModel">
              <!-- Glyph, words, and colour together: never colour on its own. -->
              <StackPanel Spacing="{DynamicResource OrzioSpaceXs}">
                <Border Classes="badge"
                        Classes.positive="{Binding IsConfirmation}"
                        Classes.critical="{Binding !IsConfirmation}"
                        HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource OrzioSpaceSm}">
                    <TextBlock Text="{Binding Glyph}" />
                    <TextBlock Text="{Binding Label}" />
                  </StackPanel>
                </Border>
                <TextBlock Classes="tertiary" Text="{Binding Explanation}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:OrderedFileListViewModel">
      <StackPanel Spacing="{DynamicResource OrzioSpaceSm}" Margin="{DynamicResource OrzioStackGapMd}">
        <TextBlock Classes="caption" Text="{Binding Label}" />

        <ListBox ItemsSource="{Binding Files}"
                 SelectedItem="{Binding Selected}"
                 Background="Transparent"
                 MaxHeight="{DynamicResource OrzioOutputLogHeight}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:OrderedFileViewModel">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource OrzioSpaceSm}">
                <TextBlock Classes="tertiary" Text="{Binding Position}" />
                <TextBlock Text="{Binding FileName}" />
                <Border Classes="badge caution" IsVisible="{Binding IsDuplicate}">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource OrzioSpaceXs}">
                    <TextBlock Text="!" />
                    <TextBlock Text="{l:Loc OrderedList.DuplicateBadge}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource OrzioSpaceSm}">
          <Button Content="{l:Loc Action.Add}" Command="{Binding AddCommand}" />
          <Button Content="{l:Loc Action.Remove}" Command="{Binding RemoveCommand}" />
          <Button Content="{l:Loc Action.MoveUp}" Command="{Binding MoveUpCommand}" />
          <Button Content="{l:Loc Action.MoveDown}" Command="{Binding MoveDownCommand}" />
        </StackPanel>

        <TextBlock Classes="tertiary"
                   IsVisible="{Binding HasDuplicates}"
                   Text="{l:Loc OrderedList.DuplicatesWarning}" />
        <TextBlock Classes="tertiary"
                   Text="{l:Loc OrderedList.OrderNote}" />
      </StackPanel>
    </DataTemplate>

  </Application.DataTemplates>

</Application>
