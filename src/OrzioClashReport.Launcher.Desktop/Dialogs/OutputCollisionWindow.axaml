<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:OrzioClashReport.Launcher.Desktop.Localization"
        x:Class="OrzioClashReport.Launcher.Desktop.Dialogs.OutputCollisionWindow"
        Title="{l:Loc Collision.Title}"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource OrzioCanvasBrush}">

  <Border Padding="{DynamicResource OrzioContentPadding}" MaxWidth="{DynamicResource OrzioDialogMaxWidth}">
    <StackPanel Spacing="{DynamicResource OrzioSpaceLg}">

      <StackPanel Spacing="{DynamicResource OrzioSpaceSm}">
        <TextBlock Classes="subtitle" Text="{l:Loc Collision.Heading}" />
        <TextBlock Classes="secondary" x:Name="ExistingFileText" />
        <TextBlock Classes="tertiary" Text="{l:Loc Collision.Explanation}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal"
                  Spacing="{DynamicResource OrzioSpaceSm}"
                  HorizontalAlignment="Right">
        <Button Content="{l:Loc Action.Cancel}" Click="OnCancel" />
        <Button Content="{l:Loc Collision.Replace}" Click="OnReplace" />
        <Button Classes="primary" Content="{l:Loc Collision.ChooseAnother}" Click="OnChooseAnother" IsDefault="True" />
      </StackPanel>

    </StackPanel>
  </Border>

</Window>
