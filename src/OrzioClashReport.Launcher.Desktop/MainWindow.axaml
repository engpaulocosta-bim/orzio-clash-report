<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OrzioClashReport.Launcher.Desktop.Localization"
        xmlns:controls="clr-namespace:OrzioClashReport.Launcher.Desktop.Controls"
        xmlns:converters="clr-namespace:OrzioClashReport.Launcher.Desktop.Converters"
        xmlns:views="clr-namespace:OrzioClashReport.Launcher.Desktop.Views"
        xmlns:vm="clr-namespace:OrzioClashReport.Launcher.Desktop.ViewModels"
        x:Class="OrzioClashReport.Launcher.Desktop.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Orzio Clash Report"
        Width="{DynamicResource OrzioWindowMinWidth}"
        Height="{DynamicResource OrzioWindowMinHeight}"
        MinWidth="{DynamicResource OrzioWindowMinWidth}"
        MinHeight="{DynamicResource OrzioWindowMinHeight}"
        Background="{DynamicResource OrzioCanvasBrush}">

  <Window.Resources>
    <converters:SectionIconConverter x:Key="SectionIcon" />
  </Window.Resources>

  <Window.DataTemplates>
    <DataTemplate DataType="vm:HomeViewModel">
      <views:HomeView />
    </DataTemplate>
    <DataTemplate DataType="vm:QuickReportViewModel">
      <views:QuickReportView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:OperationsSectionViewModel">
      <views:OperationsSectionView />
    </DataTemplate>
    <DataTemplate DataType="vm:SectionPlaceholderViewModel">
      <views:SectionPlaceholderView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="*,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*">

      <!--
        Navigation. Below the rail breakpoint the same list collapses to icons; every label stays as
        a tooltip so an icon is never the only way to know what a section is.
      -->
      <Border Grid.Column="0"
              Classes="sidebar"
              Classes.rail="{Binding IsRailMode}">
        <DockPanel>

          <Border DockPanel.Dock="Top" Classes="sidebar-header">
            <StackPanel Orientation="Horizontal" Classes="stack-md">
              <Border Classes="brand-mark" ToolTip.Tip="Orzio Clash Report">
                <TextBlock Text="OC" />
              </Border>
              <StackPanel Classes="nav-label" VerticalAlignment="Center">
                <TextBlock Classes="brand-title" Text="Orzio Clash Report" />
                <TextBlock Classes="caption" Text="{loc:Loc shell.brand.subtitle}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!--
            Updates. Checking is always a deliberate click: nothing here contacts the network on its
            own. When a newer version is found, the pulsing entry leads to Definições, where the
            installation is explained and confirmed.
          -->
          <Border DockPanel.Dock="Bottom" Classes="sidebar-footer">
            <StackPanel Classes="stack-xs">
              <Button Classes="update-available"
                      IsVisible="{Binding Updates.IsUpdateAvailable}"
                      Command="{Binding ShowUpdatesCommand}"
                      ToolTip.Tip="{Binding Updates.AvailableTooltip}">
                <StackPanel Orientation="Horizontal" Classes="stack-sm">
                  <Ellipse Classes="dot pulse" />
                  <TextBlock Classes="nav-label" Text="{loc:Loc shell.sidebar.updateAvailable}" />
                </StackPanel>
              </Button>

              <Button Classes="sidebar-action"
                      Command="{Binding Updates.CheckCommand}"
                      ToolTip.Tip="{loc:Loc shell.sidebar.checkTooltip}">
                <StackPanel Orientation="Horizontal" Classes="stack-sm">
                  <PathIcon Data="{DynamicResource OrzioIconRefresh}"
                            Classes.spin="{Binding Updates.IsChecking}" />
                  <TextBlock Classes="nav-label" Text="{loc:Loc updates.check}" />
                </StackPanel>
              </Button>

              <TextBlock Classes="caption nav-label"
                         TextTrimming="CharacterEllipsis"
                         TextWrapping="NoWrap"
                         Text="{Binding Updates.SidebarStatus}" />
            </StackPanel>
          </Border>

          <ListBox Classes="navigation"
                   ItemsSource="{Binding Sections}"
                   SelectedItem="{Binding SelectedSection, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavigationItemViewModel">
                <StackPanel Orientation="Horizontal"
                            Classes="stack-md"
                            ToolTip.Tip="{Binding Label}">
                  <PathIcon Data="{Binding Section, Converter={StaticResource SectionIcon}}" />
                  <TextBlock Classes="nav-label" Text="{Binding Label}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="content">
        <DockPanel>

          <!--
            An operation that was still running when the application last stopped. It is reported,
            never resumed: what to do about it is a human decision.
          -->
          <Border DockPanel.Dock="Top" Classes="notice caution" IsVisible="{Binding HasInterruptedOperations}">
            <StackPanel Classes="stack-sm">
              <StackPanel Orientation="Horizontal" Classes="stack-sm">
                <TextBlock Text="⚠" Classes="severity-caution" />
                <TextBlock Classes="subtitle" Text="{loc:Loc shell.interrupted.title}" />
              </StackPanel>

              <TextBlock Classes="secondary"
                         Text="{loc:Loc shell.interrupted.body}" />

              <ItemsControl ItemsSource="{Binding InterruptedOperations}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Classes="monospace" Text="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button Content="{loc:Loc shell.interrupted.acknowledge}" HorizontalAlignment="Left"
                      Command="{Binding DismissInterruptedCommand}" />
            </StackPanel>
          </Border>

          <TransitioningContentControl Content="{Binding SelectedSection.Content}">
            <TransitioningContentControl.PageTransition>
              <CrossFade Duration="0:0:0.22" />
            </TransitioningContentControl.PageTransition>
          </TransitioningContentControl>
        </DockPanel>
      </Border>

    </Grid>

    <Border Grid.Row="1" Classes="statusbar">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <TextBlock Grid.Column="0"
                   Classes="caption"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   Text="{Binding StatusMessage}" />

        <controls:EngineStatusBadge Grid.Column="1"
                                    VerticalAlignment="Center"
                                    DataContext="{Binding EngineStatus}" />
      </Grid>
    </Border>

  </Grid>

</Window>
