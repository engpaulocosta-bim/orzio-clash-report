<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Every colour, radius, spacing, and type size in the application is defined here and nowhere
    else. Views and controls reference these keys; a literal in a view is a defect.
  -->

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <Color x:Key="OrzioCanvasColor">#FFFFFF</Color>
      <Color x:Key="OrzioRaisedColor">#F7F8FA</Color>
      <Color x:Key="OrzioSunkenColor">#F0F2F5</Color>
      <Color x:Key="OrzioBorderSubtleColor">#E4E7EC</Color>
      <Color x:Key="OrzioBorderStrongColor">#D0D5DD</Color>
      <Color x:Key="OrzioTextPrimaryColor">#101828</Color>
      <Color x:Key="OrzioTextSecondaryColor">#475467</Color>
      <Color x:Key="OrzioTextTertiaryColor">#98A2B3</Color>
      <Color x:Key="OrzioAccentColor">#2A5BD7</Color>
      <Color x:Key="OrzioAccentHoverColor">#2450BE</Color>
      <Color x:Key="OrzioAccentPressedColor">#1E45A8</Color>
      <Color x:Key="OrzioAccentTintColor">#EEF3FE</Color>
      <Color x:Key="OrzioOnAccentColor">#FFFFFF</Color>

      <Color x:Key="OrzioPositiveColor">#116B45</Color>
      <Color x:Key="OrzioPositiveTintColor">#E7F5EF</Color>
      <Color x:Key="OrzioCautionColor">#8A5A00</Color>
      <Color x:Key="OrzioCautionTintColor">#FCF3E3</Color>
      <Color x:Key="OrzioCriticalColor">#B42318</Color>
      <Color x:Key="OrzioCriticalTintColor">#FDECEA</Color>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <Color x:Key="OrzioCanvasColor">#0F1216</Color>
      <Color x:Key="OrzioRaisedColor">#151A20</Color>
      <Color x:Key="OrzioSunkenColor">#1D242C</Color>
      <Color x:Key="OrzioBorderSubtleColor">#272F38</Color>
      <Color x:Key="OrzioBorderStrongColor">#364049</Color>
      <Color x:Key="OrzioTextPrimaryColor">#E6EAEF</Color>
      <Color x:Key="OrzioTextSecondaryColor">#A2AEBB</Color>
      <Color x:Key="OrzioTextTertiaryColor">#6C7A89</Color>
      <Color x:Key="OrzioAccentColor">#5B8DEF</Color>
      <Color x:Key="OrzioAccentHoverColor">#7BA3F3</Color>
      <Color x:Key="OrzioAccentPressedColor">#4A79D6</Color>
      <Color x:Key="OrzioAccentTintColor">#17243A</Color>
      <Color x:Key="OrzioOnAccentColor">#0F1216</Color>

      <Color x:Key="OrzioPositiveColor">#57C79A</Color>
      <Color x:Key="OrzioPositiveTintColor">#12291F</Color>
      <Color x:Key="OrzioCautionColor">#E0AE5A</Color>
      <Color x:Key="OrzioCautionTintColor">#2A2216</Color>
      <Color x:Key="OrzioCriticalColor">#F27F72</Color>
      <Color x:Key="OrzioCriticalTintColor">#2E1A18</Color>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

  <!-- Brushes: the only names a view is allowed to use. -->
  <SolidColorBrush x:Key="OrzioCanvasBrush" Color="{DynamicResource OrzioCanvasColor}" />
  <SolidColorBrush x:Key="OrzioRaisedBrush" Color="{DynamicResource OrzioRaisedColor}" />
  <SolidColorBrush x:Key="OrzioSunkenBrush" Color="{DynamicResource OrzioSunkenColor}" />
  <SolidColorBrush x:Key="OrzioBorderSubtleBrush" Color="{DynamicResource OrzioBorderSubtleColor}" />
  <SolidColorBrush x:Key="OrzioBorderStrongBrush" Color="{DynamicResource OrzioBorderStrongColor}" />
  <SolidColorBrush x:Key="OrzioTextPrimaryBrush" Color="{DynamicResource OrzioTextPrimaryColor}" />
  <SolidColorBrush x:Key="OrzioTextSecondaryBrush" Color="{DynamicResource OrzioTextSecondaryColor}" />
  <SolidColorBrush x:Key="OrzioTextTertiaryBrush" Color="{DynamicResource OrzioTextTertiaryColor}" />
  <SolidColorBrush x:Key="OrzioAccentBrush" Color="{DynamicResource OrzioAccentColor}" />
  <SolidColorBrush x:Key="OrzioAccentHoverBrush" Color="{DynamicResource OrzioAccentHoverColor}" />
  <SolidColorBrush x:Key="OrzioAccentPressedBrush" Color="{DynamicResource OrzioAccentPressedColor}" />
  <SolidColorBrush x:Key="OrzioAccentTintBrush" Color="{DynamicResource OrzioAccentTintColor}" />
  <SolidColorBrush x:Key="OrzioOnAccentBrush" Color="{DynamicResource OrzioOnAccentColor}" />
  <SolidColorBrush x:Key="OrzioPositiveBrush" Color="{DynamicResource OrzioPositiveColor}" />
  <SolidColorBrush x:Key="OrzioPositiveTintBrush" Color="{DynamicResource OrzioPositiveTintColor}" />
  <SolidColorBrush x:Key="OrzioCautionBrush" Color="{DynamicResource OrzioCautionColor}" />
  <SolidColorBrush x:Key="OrzioCautionTintBrush" Color="{DynamicResource OrzioCautionTintColor}" />
  <SolidColorBrush x:Key="OrzioCriticalBrush" Color="{DynamicResource OrzioCriticalColor}" />
  <SolidColorBrush x:Key="OrzioCriticalTintBrush" Color="{DynamicResource OrzioCriticalTintColor}" />

  <!-- Layout -->
  <x:Double x:Key="OrzioWindowDefaultWidth">1280</x:Double>
  <x:Double x:Key="OrzioWindowDefaultHeight">800</x:Double>
  <x:Double x:Key="OrzioWindowMinWidth">1024</x:Double>
  <x:Double x:Key="OrzioWindowMinHeight">680</x:Double>
  <x:Double x:Key="OrzioSidebarWidth">240</x:Double>
  <x:Double x:Key="OrzioRailWidth">56</x:Double>
  <x:Double x:Key="OrzioRailBreakpoint">900</x:Double>
  <x:Double x:Key="OrzioStatusBarHeight">40</x:Double>
  <x:Double x:Key="OrzioDialogMaxWidth">520</x:Double>
  <x:Double x:Key="OrzioOutputLogHeight">180</x:Double>
  <Thickness x:Key="OrzioContentPadding">32</Thickness>

  <!-- Spacing scale -->
  <x:Double x:Key="OrzioSpaceXs">4</x:Double>
  <x:Double x:Key="OrzioSpaceSm">8</x:Double>
  <x:Double x:Key="OrzioSpaceMd">16</x:Double>
  <x:Double x:Key="OrzioSpaceLg">24</x:Double>
  <x:Double x:Key="OrzioSpaceXl">32</x:Double>

  <Thickness x:Key="OrzioStackGapSm">0,0,0,8</Thickness>
  <Thickness x:Key="OrzioStackGapMd">0,0,0,16</Thickness>
  <Thickness x:Key="OrzioStackGapLg">0,0,0,24</Thickness>
  <Thickness x:Key="OrzioCardPadding">20</Thickness>
  <Thickness x:Key="OrzioFieldPadding">10,8</Thickness>
  <Thickness x:Key="OrzioBadgePadding">8,3</Thickness>
  <Thickness x:Key="OrzioNavItemPadding">12,10</Thickness>
  <Thickness x:Key="OrzioStatusBarPadding">16,0</Thickness>

  <!-- Radii -->
  <CornerRadius x:Key="OrzioRadiusSm">4</CornerRadius>
  <CornerRadius x:Key="OrzioRadiusMd">6</CornerRadius>
  <CornerRadius x:Key="OrzioRadiusLg">10</CornerRadius>
  <CornerRadius x:Key="OrzioRadiusPill">999</CornerRadius>

  <!-- Borders -->
  <Thickness x:Key="OrzioBorderThin">1</Thickness>
  <Thickness x:Key="OrzioBorderNone">0</Thickness>
  <Thickness x:Key="OrzioSidebarBorder">0,0,1,0</Thickness>
  <Thickness x:Key="OrzioStatusBarBorder">0,1,0,0</Thickness>

  <!-- Type scale -->
  <x:Double x:Key="OrzioFontSizeCaption">11</x:Double>
  <x:Double x:Key="OrzioFontSizeSmall">12</x:Double>
  <x:Double x:Key="OrzioFontSizeBody">13</x:Double>
  <x:Double x:Key="OrzioFontSizeSubtitle">15</x:Double>
  <x:Double x:Key="OrzioFontSizeTitle">20</x:Double>
  <x:Double x:Key="OrzioFontSizeDisplay">26</x:Double>

  <FontFamily x:Key="OrzioMonospaceFont">Consolas,Menlo,DejaVu Sans Mono,monospace</FontFamily>

</ResourceDictionary>
