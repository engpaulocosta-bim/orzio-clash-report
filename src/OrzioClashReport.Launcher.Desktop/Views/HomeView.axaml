<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OrzioClashReport.Launcher.Desktop.Localization"
             xmlns:controls="clr-namespace:OrzioClashReport.Launcher.Desktop.Controls"
             xmlns:vm="clr-namespace:OrzioClashReport.Launcher.Desktop.ViewModels"
             x:Class="OrzioClashReport.Launcher.Desktop.Views.HomeView"
             x:DataType="vm:HomeViewModel">

  <ScrollViewer>
    <StackPanel Classes="page">

      <!-- Hero: what the tool is for, and the one action most coordinators come for. -->
      <Border Classes="hero">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Classes="stack-md">
            <TextBlock Classes="overline" Text="{loc:Loc home.overline}" />
            <TextBlock Classes="hero-title"
                       Text="{loc:Loc home.hero.title}" />
            <TextBlock Classes="on-hero-muted"
                       Text="{loc:Loc home.hero.body}" />
            <StackPanel Orientation="Horizontal" Classes="stack-sm">
              <Button Classes="on-hero" Command="{Binding GoToQuickReportCommand}">
                <StackPanel Orientation="Horizontal" Classes="stack-sm">
                  <PathIcon Classes="small" Data="{DynamicResource OrzioIconQuickReport}" />
                  <TextBlock Text="{loc:Loc home.hero.quickReport}" />
                </StackPanel>
              </Button>
              <Button Classes="on-hero-ghost" Command="{Binding GoToLongitudinalCommand}">
                <StackPanel Orientation="Horizontal" Classes="stack-sm">
                  <TextBlock Text="{loc:Loc home.hero.compare}" />
                  <PathIcon Classes="small" Data="{DynamicResource OrzioIconArrowRight}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>

          <controls:EngineStatusBadge Grid.Column="1"
                                      VerticalAlignment="Top"
                                      DataContext="{Binding EngineStatus}" />
        </Grid>
      </Border>

      <!-- A newer version was found by an explicit check. Nothing is downloaded from here. -->
      <Border Classes="notice" IsVisible="{Binding Updates.IsUpdateAvailable}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource OrzioGapMd}">
          <Border Grid.Column="0" Classes="icon-chip">
            <PathIcon Data="{DynamicResource OrzioIconDownload}" />
          </Border>
          <StackPanel Grid.Column="1" Classes="stack-xs" VerticalAlignment="Center">
            <TextBlock Classes="subtitle"
                       Text="{Binding Updates.AvailableHeadline}" />
            <TextBlock Classes="secondary"
                       Text="{loc:Loc home.update.body}" />
          </StackPanel>
          <Button Grid.Column="2" Classes="primary" VerticalAlignment="Center"
                  Content="{loc:Loc home.update.view}" Command="{Binding GoToSettingsCommand}" />
        </Grid>
      </Border>

      <StackPanel Classes="stack-md">
        <TextBlock Classes="title" Text="{loc:Loc home.start}" />

        <Grid Classes="tiles" ColumnDefinitions="*,*,*">

          <Border Grid.Column="0" Classes="card interactive">
            <StackPanel Classes="stack-md">
              <Border Classes="icon-chip" HorizontalAlignment="Left">
                <PathIcon Data="{DynamicResource OrzioIconQuickReport}" />
              </Border>
              <StackPanel Classes="stack-xs">
                <TextBlock Classes="subtitle" Text="{loc:Loc nav.quickreport.label}" />
                <TextBlock Classes="secondary"
                           Text="{loc:Loc home.tile.quick.body}" />
              </StackPanel>
              <Button Classes="link" HorizontalAlignment="Left"
                      Command="{Binding GoToQuickReportCommand}">
                <StackPanel Orientation="Horizontal" Classes="stack-xs">
                  <TextBlock Text="{loc:Loc quick.generate}" />
                  <PathIcon Classes="small" Data="{DynamicResource OrzioIconArrowRight}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="card interactive">
            <StackPanel Classes="stack-md">
              <Border Classes="icon-chip" HorizontalAlignment="Left">
                <PathIcon Data="{DynamicResource OrzioIconSnapshots}" />
              </Border>
              <StackPanel Classes="stack-xs">
                <TextBlock Classes="subtitle" Text="{loc:Loc home.tile.snapshot.title}" />
                <TextBlock Classes="secondary"
                           Text="{loc:Loc home.tile.snapshot.body}" />
              </StackPanel>
              <Button Classes="link" HorizontalAlignment="Left"
                      Command="{Binding GoToSnapshotsCommand}">
                <StackPanel Orientation="Horizontal" Classes="stack-xs">
                  <TextBlock Text="{loc:Loc home.tile.snapshot.action}" />
                  <PathIcon Classes="small" Data="{DynamicResource OrzioIconArrowRight}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

          <Border Grid.Column="2" Classes="card interactive">
            <StackPanel Classes="stack-md">
              <Border Classes="icon-chip" HorizontalAlignment="Left">
                <PathIcon Data="{DynamicResource OrzioIconLongitudinal}" />
              </Border>
              <StackPanel Classes="stack-xs">
                <TextBlock Classes="subtitle" Text="{loc:Loc home.hero.compare}" />
                <TextBlock Classes="secondary"
                           Text="{loc:Loc home.tile.compare.body}" />
              </StackPanel>
              <Button Classes="link" HorizontalAlignment="Left"
                      Command="{Binding GoToLongitudinalCommand}">
                <StackPanel Orientation="Horizontal" Classes="stack-xs">
                  <TextBlock Text="{loc:Loc home.tile.compare.action}" />
                  <PathIcon Classes="small" Data="{DynamicResource OrzioIconArrowRight}" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Border>

        </Grid>
      </StackPanel>

      <Border Classes="card">
        <StackPanel Classes="stack-md">
          <TextBlock Classes="title" Text="{loc:Loc home.recent.title}" />

          <StackPanel Orientation="Horizontal" Classes="stack-md" IsVisible="{Binding !HasRecentOutputs}">
            <Border Classes="icon-chip">
              <PathIcon Data="{DynamicResource OrzioIconFile}" />
            </Border>
            <TextBlock Classes="secondary" VerticalAlignment="Center"
                       Text="{loc:Loc home.recent.empty}" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding RecentOutputs}" IsVisible="{Binding HasRecentOutputs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RecentOutputViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource OrzioGapMd}"
                      Margin="{DynamicResource OrzioListRowPadding}">
                  <Border Grid.Column="0" Classes="icon-chip">
                    <PathIcon Data="{DynamicResource OrzioIconFile}" />
                  </Border>
                  <StackPanel Grid.Column="1" Classes="stack-xs" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding FileName}" />
                    <StackPanel Orientation="Horizontal" Classes="stack-sm">
                      <TextBlock Classes="caption" Text="{Binding FolderName}" />
                      <TextBlock Classes="caption" Text="·" />
                      <TextBlock Classes="caption" Text="{Binding CompletedAt}" />
                    </StackPanel>
                  </StackPanel>

                  <Button Grid.Column="2"
                          Classes="ghost compact"
                          VerticalAlignment="Center"
                          Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).OpenRecentCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal" Classes="stack-xs">
                      <TextBlock Text="{loc:Loc common.open}" />
                      <PathIcon Classes="small" Data="{DynamicResource OrzioIconOpenExternal}" />
                    </StackPanel>
                  </Button>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
