<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OrzioClashReport.Launcher.Desktop.Localization"
             xmlns:controls="clr-namespace:OrzioClashReport.Launcher.Desktop.Controls"
             xmlns:views="clr-namespace:OrzioClashReport.Launcher.Desktop.Views"
             xmlns:vm="clr-namespace:OrzioClashReport.Launcher.Desktop.ViewModels"
             x:Class="OrzioClashReport.Launcher.Desktop.Views.QuickReportView"
             x:DataType="vm:QuickReportViewModel">

  <ScrollViewer>
    <StackPanel Classes="page">

      <StackPanel Classes="stack-xs">
        <TextBlock Classes="display" Text="{loc:Loc nav.quickreport.label}" />
        <TextBlock Classes="secondary"
                   Text="{loc:Loc quick.subtitle}" />
      </StackPanel>

      <controls:EngineStatusBadge DataContext="{Binding EngineStatus}"
                                  IsVisible="{Binding !IsReady}" />

      <Border Classes="card">
        <StackPanel Classes="stack-md">

          <StackPanel Classes="stack-sm">
            <TextBlock Classes="subtitle" Text="{loc:Loc quick.input.title}" />
            <TextBlock Classes="secondary" Text="{loc:Loc quick.input.description}" />
            <Grid Classes="path-field" ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Text="{Binding InputXmlPath}" Watermark="{loc:Loc picker.watermark.noFile}" />
              <Button Grid.Column="1" Content="{loc:Loc common.browse}" Command="{Binding BrowseInputCommand}" />
            </Grid>
          </StackPanel>

          <StackPanel Classes="stack-sm">
            <TextBlock Classes="subtitle" Text="{loc:Loc quick.output.title}" />
            <TextBlock Classes="secondary" Text="{loc:Loc quick.output.description}" />
            <Grid Classes="path-field" ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Text="{Binding OutputHtmlPath}" Watermark="{loc:Loc picker.watermark.noDestination}" />
              <Button Grid.Column="1" Content="{loc:Loc common.browse}" Command="{Binding BrowseOutputCommand}" />
            </Grid>
          </StackPanel>

          <Button Classes="primary"
                  HorizontalAlignment="Left"
                  Command="{Binding GenerateCommand}">
            <StackPanel Orientation="Horizontal" Classes="stack-sm">
              <PathIcon Classes="small" Data="{DynamicResource OrzioIconQuickReport}" />
              <TextBlock Text="{loc:Loc quick.generate}" />
            </StackPanel>
          </Button>

        </StackPanel>
      </Border>

      <!--
        Collision. Replacing is never the default and never automatic: both options are explicit, and
        the file being replaced is named.
      -->
      <Border Classes="notice caution" IsVisible="{Binding IsCollisionPending}">
        <StackPanel Classes="stack-sm">
          <StackPanel Orientation="Horizontal" Classes="stack-sm">
            <TextBlock Text="⚠" Classes="severity-caution" />
            <TextBlock Classes="subtitle" Text="{loc:Loc quick.collision.title}" />
          </StackPanel>

          <TextBlock Classes="monospace" Text="{Binding CollisionFileName}" />
          <TextBlock Classes="secondary"
                     Text="{loc:Loc quick.collision.body}" />

          <StackPanel Orientation="Horizontal" Classes="stack-sm">
            <Button Content="{loc:Loc common.chooseAnotherName}" Command="{Binding ChooseAnotherNameCommand}" />
            <Button Content="{loc:Loc common.replaceExistingReport}" Command="{Binding ReplaceExistingCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <views:JobPanelView DataContext="{Binding Job}" />

    </StackPanel>
  </ScrollViewer>

</UserControl>
