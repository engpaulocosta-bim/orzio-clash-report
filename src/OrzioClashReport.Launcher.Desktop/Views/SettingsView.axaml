<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:OrzioClashReport.Launcher.Desktop.Localization"
             xmlns:controls="clr-namespace:OrzioClashReport.Launcher.Desktop.Controls"
             xmlns:diagnostics="clr-namespace:OrzioClashReport.Launcher.Contracts.Diagnostics;assembly=OrzioClashReport.Launcher.Contracts"
             xmlns:vm="clr-namespace:OrzioClashReport.Launcher.Desktop.ViewModels"
             x:Class="OrzioClashReport.Launcher.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Classes="page">

      <StackPanel Classes="stack-xs">
        <TextBlock Classes="display" Text="{loc:Loc nav.settings.label}" />
        <TextBlock Classes="secondary" Text="{loc:Loc settings.subtitle}" />
      </StackPanel>

      <!--
        Updates. The network is contacted only by "Procurar atualizações", and an installer is
        downloaded only by "Instalar atualização". The download is checked against the release's
        SHA-256 before it is started, and nothing starts while an engine job is running.
      -->
      <Border Classes="card">
        <StackPanel Classes="stack-md" DataContext="{Binding Updates}" x:DataType="vm:UpdatesViewModel">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource OrzioGapMd}">
            <Border Grid.Column="0" Classes="icon-chip" Classes.positive="{Binding IsUpToDate}">
              <PathIcon Data="{DynamicResource OrzioIconDownload}" />
            </Border>
            <StackPanel Grid.Column="1" Classes="stack-xs" VerticalAlignment="Center">
              <TextBlock Classes="title" Text="{loc:Loc settings.updates.title}" />
              <TextBlock Classes="secondary"
                         Text="{loc:Loc settings.updates.body}" />
            </StackPanel>
            <Border Grid.Column="2" Classes="status-pill" VerticalAlignment="Center">
              <TextBlock Classes="monospace" Text="{Binding CurrentVersion}" />
            </Border>
          </Grid>

          <Border Classes="notice"
                  Classes.positive="{Binding IsUpToDate}"
                  Classes.critical="{Binding HasFailed}">
            <StackPanel Orientation="Horizontal" Classes="stack-sm">
              <TextBlock Text="{Binding Glyph}" />
              <TextBlock Text="{Binding StatusText}" />
            </StackPanel>
          </Border>

          <StackPanel Classes="stack-xs" IsVisible="{Binding IsDownloading}">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent}" />
            <TextBlock Classes="caption" Text="{Binding DownloadProgressText}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Classes="stack-sm">
            <Button Classes="primary"
                    IsVisible="{Binding IsUpdateAvailable}"
                    Command="{Binding InstallCommand}">
              <StackPanel Orientation="Horizontal" Classes="stack-sm">
                <PathIcon Classes="small" Data="{DynamicResource OrzioIconDownload}" />
                <TextBlock Text="{Binding InstallButtonText}" />
              </StackPanel>
            </Button>
            <Button Command="{Binding CheckCommand}">
              <StackPanel Orientation="Horizontal" Classes="stack-sm">
                <PathIcon Classes="small" Data="{DynamicResource OrzioIconRefresh}"
                          Classes.spin="{Binding IsChecking}" />
                <TextBlock Text="{loc:Loc updates.check}" />
              </StackPanel>
            </Button>
            <Button Classes="ghost"
                    IsVisible="{Binding IsUpdateAvailable}"
                    Command="{Binding OpenReleaseNotesCommand}">
              <StackPanel Orientation="Horizontal" Classes="stack-xs">
                <TextBlock Text="{loc:Loc updates.releaseNotes}" />
                <PathIcon Classes="small" Data="{DynamicResource OrzioIconOpenExternal}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <TextBlock Classes="caption" IsVisible="{Binding LastCheckedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding LastCheckedText}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Classes="stack-md">
          <TextBlock Classes="title" Text="{loc:Loc settings.appearance.title}" />

          <StackPanel Classes="stack-sm">
            <TextBlock Text="{loc:Loc settings.language.label}" />
            <ComboBox ItemsSource="{Binding LanguageOptions}"
                      SelectedItem="{Binding SelectedLanguageOption}"
                      HorizontalAlignment="Left">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="loc:LocalizedOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Classes="stack-sm">
            <TextBlock Text="{loc:Loc settings.theme.label}" />
            <ComboBox ItemsSource="{Binding ThemeOptions}"
                      SelectedItem="{Binding SelectedThemeOption}"
                      HorizontalAlignment="Left">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="loc:LocalizedOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <CheckBox IsChecked="{Binding ShowExperimentalWarnings}"
                    Content="{loc:Loc settings.experimentalWarnings}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Classes="stack-md">
          <TextBlock Classes="title" Text="{loc:Loc settings.engine.title}" />

          <controls:EngineStatusBadge DataContext="{Binding EngineStatus}" />

          <StackPanel Classes="stack-xs">
            <TextBlock Classes="caption" Text="{loc:Loc settings.engine.reportedVersion}" />
            <TextBlock Classes="monospace" Text="{Binding EngineVersion}" />
          </StackPanel>

          <StackPanel Classes="stack-xs">
            <TextBlock Classes="caption" Text="{loc:Loc settings.engine.integrity}" />
            <TextBlock Classes="secondary" Text="{Binding EngineIntegrity}" />
          </StackPanel>

          <StackPanel Classes="stack-xs">
            <TextBlock Classes="caption" Text="{loc:Loc settings.engine.applicationVersion}" />
            <TextBlock Classes="monospace" Text="{Binding LauncherVersion}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Classes="stack-md">
          <TextBlock Classes="title" Text="{loc:Loc settings.data.title}" />
          <TextBlock Classes="secondary"
                     Text="{loc:Loc settings.data.body}" />

          <TextBlock Classes="monospace" Text="{Binding DataDirectory}" />

          <StackPanel Orientation="Horizontal" Classes="stack-sm">
            <Button Content="{loc:Loc settings.data.open}" Command="{Binding OpenDataFolderCommand}" />
            <Button Content="{loc:Loc settings.data.clearRecent}" Command="{Binding ClearRecentOutputsCommand}" />
          </StackPanel>

          <TextBlock Classes="caption" Text="{Binding StatusMessage}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Classes="stack-md">
          <TextBlock Classes="title" Text="{loc:Loc settings.diagnostics.title}" />
          <TextBlock Classes="secondary"
                     Text="{loc:Loc settings.diagnostics.body}" />

          <Button Content="{loc:Loc settings.diagnostics.preview}" HorizontalAlignment="Left"
                  Command="{Binding PrepareDiagnosticsCommand}" />

          <StackPanel Classes="stack-md" IsVisible="{Binding HasDiagnosticsPreview}">

            <StackPanel Classes="stack-sm">
              <TextBlock Classes="subtitle" Text="{loc:Loc settings.diagnostics.contents}" />
              <ItemsControl ItemsSource="{Binding DiagnosticPlan}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DiagnosticItemViewModel">
                    <StackPanel Classes="stack-xs">
                      <TextBlock Classes="monospace" Text="{Binding FileName}" />
                      <TextBlock Classes="caption" Text="{Binding Description}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="secondary"
                         Text="{loc:Loc settings.diagnostics.excluded}" />
            </StackPanel>

            <StackPanel Classes="stack-sm">
              <TextBlock Classes="subtitle" Text="{loc:Loc settings.diagnostics.logPreview}" />
              <ScrollViewer MaxHeight="{DynamicResource OrzioEngineOutputMaxHeight}">
                <SelectableTextBlock Classes="monospace" Text="{Binding RedactedLogPreview}" />
              </ScrollViewer>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Classes="stack-sm">
              <Button Classes="primary" Content="{loc:Loc settings.diagnostics.create}"
                      Command="{Binding CreateDiagnosticsBundleCommand}" />
              <Button Content="{loc:Loc common.revealInFolder}"
                      IsVisible="{Binding CanRevealDiagnosticsBundle}"
                      Command="{Binding RevealDiagnosticsBundleCommand}" />
            </StackPanel>

          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Classes="stack-sm">
          <TextBlock Classes="title" Text="{loc:Loc settings.promise.title}" />
          <TextBlock Classes="secondary"
                     Text="{loc:Loc settings.promise.body}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
