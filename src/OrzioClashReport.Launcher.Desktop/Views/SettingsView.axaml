<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OrzioClashReport.Launcher.Desktop.ViewModels"
             x:Class="OrzioClashReport.Launcher.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Spacing="{DynamicResource OrzioSpaceLg}">

      <TextBlock Classes="title" Text="Definições" />

      <Border Classes="card">
        <StackPanel Spacing="{DynamicResource OrzioSpaceMd}">
          <TextBlock Classes="caption" Text="APARÊNCIA" />
          <StackPanel Spacing="{DynamicResource OrzioSpaceXs}">
            <TextBlock Text="Tema" />
            <ComboBox ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding SelectedTheme}"
                      HorizontalAlignment="Left"
                      MinWidth="{DynamicResource OrzioSidebarWidth}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ThemeOptionViewModel">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="{DynamicResource OrzioSpaceMd}">
          <TextBlock Classes="caption" Text="AVISOS" />
          <CheckBox IsChecked="{Binding ShowExperimentalWarnings}"
                    Content="Mostrar aviso quando uma operação for experimental" />
          <TextBlock Classes="tertiary"
                     Text="A comparação entre revisões ainda não foi validada com três exports históricos reais." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="{DynamicResource OrzioSpaceMd}">
          <TextBlock Classes="caption" Text="DADOS LOCAIS" />
          <StackPanel Spacing="{DynamicResource OrzioSpaceXs}">
            <TextBlock Classes="secondary" Text="Esta aplicação guarda definições, registos e estado de trabalhos em:" />
            <TextBlock Classes="mono" Text="{Binding LocalDataDirectory}" />
            <TextBlock Classes="tertiary"
                       Text="Os seus projetos, snapshots e relatórios nunca são guardados aqui e não são removidos ao desinstalar." />
          </StackPanel>
          <StackPanel Spacing="{DynamicResource OrzioSpaceXs}">
            <TextBlock Classes="secondary" Text="Versão da aplicação" />
            <TextBlock Classes="mono" Text="{Binding LauncherVersion}" />
          </StackPanel>
          <TextBlock Classes="tertiary"
                     Text="Sem telemetria, sem envio de dados e sem conta. Tudo permanece nesta máquina." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="{DynamicResource OrzioSpaceMd}">
          <TextBlock Classes="caption" Text="DIAGNÓSTICO" />
          <TextBlock Classes="secondary" Text="{Binding Diagnostics.Explanation}" />

          <Button Content="Ver o que seria incluído"
                  HorizontalAlignment="Left"
                  Command="{Binding Diagnostics.ShowPreviewCommand}" />

          <StackPanel Spacing="{DynamicResource OrzioSpaceSm}"
                      IsVisible="{Binding Diagnostics.IsPreviewVisible}">
            <TextBlock Classes="caption" Text="FICHEIROS INCLUÍDOS" />
            <ItemsControl ItemsSource="{Binding Diagnostics.IncludedFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="mono" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="caption" Text="PRÉ-VISUALIZAÇÃO DO REGISTO REDIGIDO" />
            <TextBlock Classes="tertiary"
                       IsVisible="{Binding !Diagnostics.HasLogPreview}"
                       Text="Ainda não há registos nesta máquina." />
            <Border Classes="sunken"
                    Padding="{DynamicResource OrzioCardPadding}"
                    IsVisible="{Binding Diagnostics.HasLogPreview}">
              <ScrollViewer Height="{DynamicResource OrzioOutputLogHeight}">
                <ItemsControl ItemsSource="{Binding Diagnostics.LogPreviewLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Classes="mono" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource OrzioSpaceSm}">
              <Button Content="Gerar pacote de diagnóstico"
                      Command="{Binding Diagnostics.CreateBundleCommand}" />
              <Button Classes="link"
                      Content="Mostrar na pasta"
                      Command="{Binding Diagnostics.RevealBundleCommand}"
                      IsVisible="{Binding Diagnostics.HasBundle}" />
              <TextBlock VerticalAlignment="Center"
                         Text="{Binding Diagnostics.LastBundleFileName}"
                         IsVisible="{Binding Diagnostics.HasBundle}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Spacing="{DynamicResource OrzioSpaceXs}"
                        IsVisible="{Binding Diagnostics.HasFailure}">
              <TextBlock Text="✕" />
              <TextBlock Classes="secondary" Text="{Binding Diagnostics.FailureMessage}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
