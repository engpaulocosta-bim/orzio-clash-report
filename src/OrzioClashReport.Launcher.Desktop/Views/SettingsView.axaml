<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OrzioClashReport.Launcher.Desktop.Controls"
             xmlns:diagnostics="clr-namespace:OrzioClashReport.Launcher.Contracts.Diagnostics;assembly=OrzioClashReport.Launcher.Contracts"
             xmlns:vm="clr-namespace:OrzioClashReport.Launcher.Desktop.ViewModels"
             x:Class="OrzioClashReport.Launcher.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Classes="page">

      <StackPanel Classes="stack-xs">
        <TextBlock Classes="display" Text="Definições" />
        <TextBlock Classes="secondary" Text="Aparência, atualizações, dados locais e estado do motor." />
      </StackPanel>

      <!--
        Updates. The network is contacted only by "Procurar atualizações", and an installer is
        downloaded only by "Instalar atualização". The download is checked against the release's
        SHA-256 before it is started, and nothing starts while an engine job is running.
      -->
      <Border Classes="card">
        <StackPanel Classes="stack-md" DataContext="{Binding Updates}" x:DataType="vm:UpdatesViewModel">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource OrzioGapMd}">
            <Border Grid.Column="0" Classes="icon-chip" Classes.positive="{Binding IsUpToDate}">
              <PathIcon Data="{DynamicResource OrzioIconDownload}" />
            </Border>
            <StackPanel Grid.Column="1" Classes="stack-xs" VerticalAlignment="Center">
              <TextBlock Classes="title" Text="Atualizações" />
              <TextBlock Classes="secondary"
                         Text="Procura uma nova versão oficial no GitHub apenas quando o pedir. A instalação só começa com a sua confirmação." />
            </StackPanel>
            <Border Grid.Column="2" Classes="status-pill" VerticalAlignment="Center">
              <TextBlock Classes="monospace" Text="{Binding CurrentVersion}" />
            </Border>
          </Grid>

          <Border Classes="notice"
                  Classes.positive="{Binding IsUpToDate}"
                  Classes.critical="{Binding HasFailed}">
            <StackPanel Orientation="Horizontal" Classes="stack-sm">
              <TextBlock Text="{Binding Glyph}" />
              <TextBlock Text="{Binding StatusText}" />
            </StackPanel>
          </Border>

          <StackPanel Classes="stack-xs" IsVisible="{Binding IsDownloading}">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadPercent}" />
            <TextBlock Classes="caption" Text="{Binding DownloadPercent, StringFormat='{}{0:0}% descarregado'}" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Classes="stack-sm">
            <Button Classes="primary"
                    IsVisible="{Binding IsUpdateAvailable}"
                    Command="{Binding InstallCommand}">
              <StackPanel Orientation="Horizontal" Classes="stack-sm">
                <PathIcon Classes="small" Data="{DynamicResource OrzioIconDownload}" />
                <TextBlock Text="{Binding AvailableVersion, StringFormat='Instalar atualização {0}'}" />
              </StackPanel>
            </Button>
            <Button Command="{Binding CheckCommand}">
              <StackPanel Orientation="Horizontal" Classes="stack-sm">
                <PathIcon Classes="small" Data="{DynamicResource OrzioIconRefresh}"
                          Classes.spin="{Binding IsChecking}" />
                <TextBlock Text="Procurar atualizações" />
              </StackPanel>
            </Button>
            <Button Classes="ghost"
                    IsVisible="{Binding IsUpdateAvailable}"
                    Command="{Binding OpenReleaseNotesCommand}">
              <StackPanel Orientation="Horizontal" Classes="stack-xs">
                <TextBlock Text="Notas da versão" />
                <PathIcon Classes="small" Data="{DynamicResource OrzioIconOpenExternal}" />
              </StackPanel>
            </Button>
          </StackPanel>

          <TextBlock Classes="caption" IsVisible="{Binding LastCheckedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding LastCheckedText}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Classes="stack-md">
          <TextBlock Classes="title" Text="Aparência" />

          <StackPanel Classes="stack-sm">
            <TextBlock Text="Tema" />
            <ComboBox ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding Theme}"
                      HorizontalAlignment="Left" />
          </StackPanel>

          <CheckBox IsChecked="{Binding ShowExperimentalWarnings}"
                    Content="Mostrar avisos em funcionalidades experimentais" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Classes="stack-md">
          <TextBlock Classes="title" Text="Motor" />

          <controls:EngineStatusBadge DataContext="{Binding EngineStatus}" />

          <StackPanel Classes="stack-xs">
            <TextBlock Classes="caption" Text="Versão reportada" />
            <TextBlock Classes="monospace" Text="{Binding EngineVersion}" />
          </StackPanel>

          <StackPanel Classes="stack-xs">
            <TextBlock Classes="caption" Text="Integridade" />
            <TextBlock Classes="secondary" Text="{Binding EngineIntegrity}" />
          </StackPanel>

          <StackPanel Classes="stack-xs">
            <TextBlock Classes="caption" Text="Versão da aplicação" />
            <TextBlock Classes="monospace" Text="{Binding LauncherVersion}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Classes="stack-md">
          <TextBlock Classes="title" Text="Dados locais" />
          <TextBlock Classes="secondary"
                     Text="Definições, lista de recentes, registos e jobs ficam na sua pasta de utilizador. Os relatórios e ficheiros de projeto ficam onde os guardar, e a desinstalação não lhes toca." />

          <TextBlock Classes="monospace" Text="{Binding DataDirectory}" />

          <StackPanel Orientation="Horizontal" Classes="stack-sm">
            <Button Content="Abrir pasta de dados" Command="{Binding OpenDataFolderCommand}" />
            <Button Content="Limpar lista de recentes" Command="{Binding ClearRecentOutputsCommand}" />
          </StackPanel>

          <TextBlock Classes="caption" Text="{Binding StatusMessage}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Classes="stack-md">
          <TextBlock Classes="title" Text="Diagnóstico" />
          <TextBlock Classes="secondary"
                     Text="Um pacote de diagnóstico é criado apenas quando o pedir, fica na sua pasta de dados e não é enviado para lado nenhum." />

          <Button Content="Ver o que seria incluído" HorizontalAlignment="Left"
                  Command="{Binding PrepareDiagnosticsCommand}" />

          <StackPanel Classes="stack-md" IsVisible="{Binding HasDiagnosticsPreview}">

            <StackPanel Classes="stack-sm">
              <TextBlock Classes="subtitle" Text="O pacote contém exatamente estes ficheiros" />
              <ItemsControl ItemsSource="{Binding DiagnosticPlan}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="diagnostics:DiagnosticBundleItem">
                    <StackPanel Classes="stack-xs">
                      <TextBlock Classes="monospace" Text="{Binding FileName}" />
                      <TextBlock Classes="caption" Text="{Binding Description}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="secondary"
                         Text="Nenhum ficheiro seu é incluído: nem XML, nem manifest, nem snapshot, nem governança, nem relatórios." />
            </StackPanel>

            <StackPanel Classes="stack-sm">
              <TextBlock Classes="subtitle" Text="Pré-visualização do registo redigido" />
              <ScrollViewer MaxHeight="{DynamicResource OrzioEngineOutputMaxHeight}">
                <SelectableTextBlock Classes="monospace" Text="{Binding RedactedLogPreview}" />
              </ScrollViewer>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Classes="stack-sm">
              <Button Classes="primary" Content="Gerar pacote"
                      Command="{Binding CreateDiagnosticsBundleCommand}" />
              <Button Content="Mostrar na pasta"
                      IsVisible="{Binding CanRevealDiagnosticsBundle}"
                      Command="{Binding RevealDiagnosticsBundleCommand}" />
            </StackPanel>

          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Classes="stack-sm">
          <TextBlock Classes="title" Text="O que esta aplicação não faz" />
          <TextBlock Classes="secondary"
                     Text="Não recolhe telemetria e não envia os seus ficheiros. Funciona offline, exceto ao procurar ou descarregar atualizações a pedido do utilizador. Os registos locais não guardam caminhos absolutos nem conteúdo dos seus ficheiros." />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
