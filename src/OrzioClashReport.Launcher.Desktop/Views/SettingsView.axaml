<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OrzioClashReport.Launcher.Desktop.ViewModels"
             x:Class="OrzioClashReport.Launcher.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Spacing="{DynamicResource OrzioSpaceLg}">

      <TextBlock Classes="title" Text="{Binding Title}" />

      <Border Classes="card">
        <StackPanel Spacing="{DynamicResource OrzioSpaceMd}">
          <TextBlock Classes="caption" Text="{Binding AppearanceCaption}" />
          <StackPanel Spacing="{DynamicResource OrzioSpaceXs}">
            <TextBlock Text="{Binding ThemeLabel}" />
            <ComboBox ItemsSource="{Binding Themes}"
                      SelectedItem="{Binding SelectedTheme}"
                      HorizontalAlignment="Left"
                      MinWidth="{DynamicResource OrzioSidebarWidth}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ThemeOptionViewModel">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="{DynamicResource OrzioSpaceXs}">
            <TextBlock Text="{Binding LanguageLabel}" />
            <ComboBox ItemsSource="{Binding Languages}"
                      SelectedItem="{Binding SelectedLanguage}"
                      HorizontalAlignment="Left"
                      MinWidth="{DynamicResource OrzioSidebarWidth}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LanguageOptionViewModel">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="{DynamicResource OrzioSpaceMd}">
          <TextBlock Classes="caption" Text="{Binding WarningsCaption}" />
          <CheckBox IsChecked="{Binding ShowExperimentalWarnings}"
                    Content="{Binding ShowExperimentalLabel}" />
          <TextBlock Classes="tertiary"
                     Text="{Binding ExperimentalNote}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="{DynamicResource OrzioSpaceMd}">
          <TextBlock Classes="caption" Text="{Binding LocalDataCaption}" />
          <StackPanel Spacing="{DynamicResource OrzioSpaceXs}">
            <TextBlock Classes="secondary" Text="{Binding LocalDataIntro}" />
            <TextBlock Classes="mono" Text="{Binding LocalDataDirectory}" />
            <TextBlock Classes="tertiary"
                       Text="{Binding LocalDataNote}" />
          </StackPanel>
          <StackPanel Spacing="{DynamicResource OrzioSpaceXs}">
            <TextBlock Classes="secondary" Text="{Binding VersionLabel}" />
            <TextBlock Classes="mono" Text="{Binding LauncherVersion}" />
          </StackPanel>
          <TextBlock Classes="tertiary"
                     Text="{Binding PrivacyNote}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="{DynamicResource OrzioSpaceMd}">
          <TextBlock Classes="caption" Text="{Binding Diagnostics.Caption}" />
          <TextBlock Classes="secondary" Text="{Binding Diagnostics.Explanation}" />

          <Button Content="{Binding Diagnostics.ShowPreviewLabel}"
                  HorizontalAlignment="Left"
                  Command="{Binding Diagnostics.ShowPreviewCommand}" />

          <StackPanel Spacing="{DynamicResource OrzioSpaceSm}"
                      IsVisible="{Binding Diagnostics.IsPreviewVisible}">
            <TextBlock Classes="caption" Text="{Binding Diagnostics.FilesCaption}" />
            <ItemsControl ItemsSource="{Binding Diagnostics.IncludedFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Classes="mono" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="caption" Text="{Binding Diagnostics.LogCaption}" />
            <TextBlock Classes="tertiary"
                       IsVisible="{Binding !Diagnostics.HasLogPreview}"
                       Text="{Binding Diagnostics.NoLogNote}" />
            <Border Classes="sunken"
                    Padding="{DynamicResource OrzioCardPadding}"
                    IsVisible="{Binding Diagnostics.HasLogPreview}">
              <ScrollViewer Height="{DynamicResource OrzioOutputLogHeight}">
                <ItemsControl ItemsSource="{Binding Diagnostics.LogPreviewLines}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Classes="mono" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource OrzioSpaceSm}">
              <Button Content="{Binding Diagnostics.CreateLabel}"
                      Command="{Binding Diagnostics.CreateBundleCommand}" />
              <Button Classes="link"
                      Content="{Binding Diagnostics.RevealLabel}"
                      Command="{Binding Diagnostics.RevealBundleCommand}"
                      IsVisible="{Binding Diagnostics.HasBundle}" />
              <TextBlock VerticalAlignment="Center"
                         Text="{Binding Diagnostics.LastBundleFileName}"
                         IsVisible="{Binding Diagnostics.HasBundle}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Spacing="{DynamicResource OrzioSpaceXs}"
                        IsVisible="{Binding Diagnostics.HasFailure}">
              <TextBlock Text="✕" />
              <TextBlock Classes="secondary" Text="{Binding Diagnostics.FailureMessage}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
