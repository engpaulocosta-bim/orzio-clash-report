<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    Headless UI smoke tests. They exist because the shell's XAML, resource tokens and bindings are
    only resolved at runtime: without them, a broken token reference would ship unnoticed and only
    fail on an evaluator's machine.
  -->
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.20" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OrzioClashReport.Launcher.Desktop\OrzioClashReport.Launcher.Desktop.csproj" />
  </ItemGroup>

</Project>
