<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>fake-engine</AssemblyName>
  </PropertyGroup>

  <!--
    A stand-in engine for the launcher's integration tests. It exists so the process runner can be
    exercised against a real child process across every behaviour that matters — including the ones
    the real engine is not supposed to produce — without needing the real engine or a real export.
  -->

</Project>
