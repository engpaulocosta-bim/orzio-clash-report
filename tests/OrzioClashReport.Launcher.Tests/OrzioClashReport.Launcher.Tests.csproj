<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The launcher test project deliberately does not reference the desktop project: keeping the UI out
    of the test graph is what stops UI types from leaking into testable policy.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\OrzioClashReport.Launcher.Application\OrzioClashReport.Launcher.Application.csproj" />
    <ProjectReference Include="..\..\src\OrzioClashReport.Launcher.Contracts\OrzioClashReport.Launcher.Contracts.csproj" />
    <ProjectReference Include="..\..\src\OrzioClashReport.Launcher.Infrastructure\OrzioClashReport.Launcher.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    The fake engine is a real child process the integration tests launch. ReferenceOutputAssembly is
    off because the tests invoke its executable, they do not link against it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\OrzioClashReport.Launcher.FakeEngine\OrzioClashReport.Launcher.FakeEngine.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="None" />
  </ItemGroup>

</Project>
